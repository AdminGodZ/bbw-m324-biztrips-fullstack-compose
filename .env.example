# Copy to .env and adjust if needed. All values are for local development only.
DB_NAME=db_biztrips
DB_USER=biztrips
DB_PASSWORD=local-dev-only
DB_ROOT_PASSWORD=local-root-only
S3_BUCKET=biztrips-photos-local
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT_LOCAL=3306

# Only for compose.ecr.yaml (released images from Amazon ECR):
# ECR_REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com
BACKEND_VERSION=5.0.1
FRONTEND_VERSION=5.0.1
